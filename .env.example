# Copy to .env, set your own password, and source before starting services.
# .env is ignored by Git. Never commit your populated configuration.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stock
DB_USER=root
DB_PASSWORD=replace_with_your_local_password
DB_URL='jdbc:mysql://localhost:3306/stock?rewriteBatchedStatements=true'
# Optional absolute paths: MODEL_SRC_DIR, ARTIFACTS_DIR, INDUSTRY_EXCEL
